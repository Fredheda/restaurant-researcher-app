flowchart TB
  classDef new fill:#d4f4dd,stroke:#2da44e,color:#0b3d1a
  classDef changed fill:#fff1c9,stroke:#d29922,color:#4a3500
  classDef unchanged fill:#e8eaed,stroke:#8c959f,color:#24292f

  legend["Legend: green = new, amber = changed, grey = unchanged or from another PR (same colours on arrows)"]:::unchanged

  subgraph GH["GitHub (repo Fredheda/restaurant-researcher-app)"]
    wf["Deploy infra workflow: workflow_dispatch only, main only, optional SHA, shared deploy-production queue"]:::new
    prodenv["production environment: owner approval, main only"]:::unchanged
    envsec["production environment secrets: GOOGLE_PLACES_API_KEY, OPENAI_API_KEY, SQL_SERVER, SQL_DATABASE"]:::new
    reposec["repo secret AZURE_INFRA_CLIENT_ID (set by setup script, RR-33)"]:::new
    dep["Deploy workflow: build, roll, lock tags"]:::unchanged
  end

  subgraph SCR["Repo scripts"]
    bicepinst["az bicep install --version pinned (14 days or older)"]:::new
    ci["scripts/ci-azure-login.sh"]:::unchanged
    deploysh["infra/deploy.sh (RR-32): no registry call"]:::unchanged
    wait["scripts/wait-healthy.sh"]:::unchanged
    sc["scripts/tests/test-supply-chain.sh: pin check"]:::changed
  end

  subgraph ID["Azure identity and RBAC (setup script, RR-33)"]
    infraid["infra identity + custom role at rg-chatbot (13 actions), no registry, role or identity writes"]:::unchanged
  end

  subgraph AZ["Azure resources (infra/main.bicep, RR-32)"]
    apps["Container Apps: web, api, agent; environment and identities existing"]:::unchanged
  end

  prodenv -- "approval gate" --> wf
  envsec --> wf
  reposec --> wf
  wf --> bicepinst
  wf --> ci
  ci -- "OIDC login" --> infraid
  wf --> deploysh
  wf --> wait
  deploysh -- "az deployment group create" --> apps
  infraid -. "deploy rights" .-> apps
  dep --> prodenv
  sc -. "checks" .-> wf

  linkStyle 1,2,3,4,5,6,7 stroke:#2da44e,stroke-width:2px
  linkStyle 11 stroke:#d29922,stroke-width:2px
  linkStyle 0,8,9,10 stroke:#8c959f,stroke-width:2px
